<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 — missing XML doc comments on public members (we suppress because Generate-
               DocumentationFile is on for package metadata, not strict doc enforcement).
      CA1720 — identifier contains type name. Stampd's domain vocabulary (Signed, Sealed,
               Object) overlaps reserved words; renaming would distort the model.
      CA1861 — constant array argument. EF Core scaffolds migrations that pass column-name
               arrays inline at table-creation time; the analyser flags the pattern but it
               runs once per migration, not in a hot loop, and EF will regenerate the same
               shape every time. Not actionable.
    -->
    <NoWarn>$(NoWarn);CS1591;CA1720;CA1861</NoWarn>

    <!--
      Enforce NuGet lock files solution-wide. Generates packages.lock.json next
      to every csproj on restore and makes the build fail if any transitive
      version drifts from what's locked. Required by OSSF Scorecard's
      PinnedDependenciesID rule (nugetCommand not pinned by hash) and by
      Qodana Ultimate's SCA pipeline (reads packages.lock.json for CVE scan).
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <!--
      Single source of truth for package version. Bump here on every release; CI publishes
      whatever's checked in when the tag pushes. Pre-releases use a suffix — set Version
      to the target stable (e.g. 1.3.0) and add VersionSuffix (e.g. preview.1) so the
      effective package version becomes 1.3.0-preview.1.
    -->
    <!--
      v3.3.0: the signed-document record names the sealing provider, the signing key's
      thumbprint, the timestamp authority and the PAdES level actually reached
      (SignedDocument.AchievedLevel); signing-request responses carry signedDocumentId;
      admin exports and analytics run on SQLite (V19 migration). See MIGRATION.md.
      v3.2.0: enforces signing-request expiry and closes voided, expired and declined
      requests to recipients (410), refuses webhook URLs on internal addresses unless
      allowlisted, makes bulk-send rows idempotent (V18 migration), validates signature
      images, and keeps sealing working through slow revocation responders and
      non-exportable keys. See MIGRATION.md.
      v3.1.0: the WebApi takes the request's tenant from the access token, requires the
      Sender or Admin role on write routes, and returns recipient access URLs only to the
      request's owner and Admins. Adds SigningRequest.NotifyEmail (V17 migration). Also
      fixes the B-LTA archive timestamp input and the CMS signature algorithm on the
      provider signing path, and keeps access tokens out of logs. See MIGRATION.md.
      v3.0.1 patch: security updates for vulnerable transitive packages (Microsoft.* 10.0.15),
      and THIRD-PARTY-NOTICES.txt bundled in every package. No API changes.
      v3.0.0 shipped tenant-isolated admin scopes, OIDC relay for external IdPs, SAML2 SP
      scaffolding and industry compliance bundles. Rules engine moved to v3.1 candidates.
    -->
    <Version>3.3.0</Version>

    <Product>Stampd</Product>
    <Authors>Suresh Subramanian and Stampd contributors</Authors>
    <Company>Stampd</Company>
    <Copyright>Copyright (c) Stampd contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/isureshsubramanian/Stampd</PackageProjectUrl>
    <RepositoryUrl>https://github.com/isureshsubramanian/Stampd</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!--
      Per-project files. Each library csproj sets PackageReadmeFile to its local README.md
      (placed next to the csproj). Apps (Stampd.WebApi, Stampd.UI), samples, and tests
      override IsPackable=false so they're excluded from the pack pass below.
    -->
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Embed XML docs + symbols inside the package so consumers can step into Stampd code
      from their IDE without a separate .snupkg. snupkg is the better long-term path
      (smaller .nupkg, symbols on Microsoft's symbol server), but embedding is friction-free
      for the 1.2 release.
    -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup Label="SourceLink" Condition="'$(IsPackable)' == 'true'">
    <!--
      Source Link maps PDB line numbers back to the corresponding github.com blob URL, so
      anyone consuming a Stampd package can step into source-tagged at the released SHA
      without needing the .snupkg or a local clone.
    -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.404" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Label="Third-party notices" Condition="'$(IsPackable)' == 'true'">
    <!--
      Every package carries the generated attributions for Stampd's dependencies at its root.
      Regenerate by running the tools/Stampd.Tools.Notices project; CI fails if it is stale.
    -->
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup Label="Deterministic builds">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
