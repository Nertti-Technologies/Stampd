<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Stampd.Email.Smtp</PackageId>
    <Description>SMTP IEmailSender for Stampd, backed by MailKit. Works against any RFC 5321 SMTP server: in-process dev tools (Hermex), corporate Postfix/Exchange, hosted SMTP (SendGrid SMTP, SES SMTP, Mailgun, etc.).</Description>
    <PackageTags>stampd;email;smtp;mailkit</PackageTags>
    <RootNamespace>Stampd.Email.Smtp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stampd.Core\Stampd.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- Security pin: MailKit/MimeKit 4.17 resolves System.Security.Cryptography.Pkcs 10.0.0, affected by
         GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate); 10.0.13+ is patched.
         Remove once MailKit/MimeKit 4.17 itself depends on a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
